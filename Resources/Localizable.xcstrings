    "“%@” and “%@” share a key, so holding it does both." : {
      "comment" : "Two hold-key settings by name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” and “%2$@” share a key, so holding it does both."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und „%@“ nutzen dieselbe Taste, daher bewirkt Gedrückthalten beides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et « %@ » utilisent la même touche ; la maintenir fait donc les deux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y «%@» comparten tecla, así que mantenerla hace ambas cosas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」と「%@」が同じキーを使っているため、押し続けると両方の動作をします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”和“%@”使用同一个键，因此按住它会同时执行两者。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ en ‘%@’ gebruiken dezelfde toets, dus ingedrukt houden doet beide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e “%@” usam a mesma tecla, então mantê-la pressionada faz as duas coisas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e “%@” usam a mesma tecla, por isso mantê-la premida faz as duas coisas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」和「%@」使用同一個按鍵，因此按住它會同時執行兩者。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’과(와) ‘%@’이(가) 같은 키를 사용하므로 누르고 있으면 두 동작을 모두 수행합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и «%@» используют одну клавишу, поэтому ее удержание выполняет оба действия."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” i „%@” używają tego samego klawisza, więc przytrzymanie go wykonuje obie czynności."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα «%@» και «%@» χρησιμοποιούν το ίδιο πλήκτρο, οπότε κρατώντας το γίνονται και τα δύο."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve “%@” aynı tuşu kullanıyor, bu yüzden basılı tutmak ikisini birden yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» і «%@» використовують одну клавішу, тож її утримання виконує обидві дії."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dan “%@” memakai tombol yang sama, jadi menahannya melakukan keduanya."
          }
        }
      }
    },

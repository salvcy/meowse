    "If the window macOS opened was closed, it’s here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls das von macOS geöffnete Fenster geschlossen wurde, findest du es hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la fenêtre ouverte par macOS a été fermée, elle se trouve ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se cerró la ventana que abrió macOS, está aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが開いたウインドウを閉じてしまった場合はこちらです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 macOS 打开的窗口已关闭，可在此找到。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het venster dat macOS opende is gesloten, vind je het hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a janela aberta pelo macOS foi fechada, ela está aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a janela aberta pelo macOS foi fechada, está aqui."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 macOS 打開的視窗已關閉，可在此找到。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 연 윈도우를 닫았다면 여기에서 찾을 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если окно, открытое macOS, было закрыто, оно здесь."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli okno otwarte przez macOS zostało zamknięte, znajdziesz je tutaj."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έκλεισε το παράθυρο που άνοιξε το macOS, βρίσκεται εδώ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS’un açtığı pencere kapatıldıysa buradadır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вікно, відкрите macOS, було закрито, воно тут."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika jendela yang dibuka macOS sudah ditutup, ada di sini."

    "Turn on Meowse in System Settings → Privacy & Security → Accessibility. It takes effect within a few seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Meowse in „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Bedienungshilfen“. Die Änderung wirkt nach wenigen Sekunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Meowse dans Réglages Système → Confidentialité et sécurité → Accessibilité. Le changement prend effet en quelques secondes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Meowse en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad. Surte efecto en unos segundos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」→「プライバシーとセキュリティ」→「アクセシビリティ」でMeowseをオンにしてください。数秒で有効になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”→“隐私与安全性”→“辅助功能”中打开 Meowse。几秒钟内即可生效。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Meowse in via Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid. Het werkt binnen een paar seconden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Meowse em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade. Isso entra em vigor em alguns segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Meowse em Definições do Sistema → Privacidade e segurança → Acessibilidade. Fica ativo em poucos segundos."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「系統設定」→「隱私權與安全性」→「輔助使用」中開啟 Meowse。幾秒鐘內即會生效。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 Meowse를 켜십시오. 몇 초 안에 적용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Meowse в разделе «Системные настройки» → «Конфиденциальность и безопасность» → «Универсальный доступ». Изменение вступит в силу через несколько секунд."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Meowse w Ustawieniach systemowych → Prywatność i ochrona → Dostępność. Zmiana zadziała w ciągu kilku sekund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το Meowse στις Ρυθμίσεις συστήματος → Απόρρητο και ασφάλεια → Προσβασιμότητα. Ισχύει μέσα σε λίγα δευτερόλεπτα."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde Meowse’u açın. Birkaç saniye içinde etkili olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Meowse у «Системні параметри» → «Приватність і безпека» → «Доступність». Зміна набуде чинності за кілька секунд."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Meowse di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas. Berlaku dalam beberapa detik."
          }
        }
      }
    },

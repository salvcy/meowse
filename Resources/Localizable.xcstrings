            "value" : "Meowse nie może zastąpić się w %@. Pobierz uaktualnienie ze strony wydania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meowse não consegue se substituir em %@. Baixe a atualização na página da versão."
          }
        },
        "pt-PT" : {

    "%@ You can drag Meowse there in Finder." : {
      "comment" : "After the system's error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Du kannst Meowse im Finder dorthin ziehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vous pouvez faire glisser Meowse dans ce dossier depuis le Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Puedes arrastrar Meowse allí en el Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ FinderでMeowseをそこにドラッグできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 你可以在访达中将 Meowse 拖到那里。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Je kunt Meowse er in de Finder naartoe slepen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Você pode arrastar o Meowse para lá no Finder."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pode arrastar o Meowse para lá no Finder."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 你可以在 Finder 中將 Meowse 拖移到該處。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Finder에서 Meowse를 그곳으로 드래그할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Перетяните Meowse туда в Finder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Możesz przeciągnąć tam Meowse w Finderze."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Μπορείτε να σύρετε το Meowse εκεί στο Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Meowse’u Finder’da oraya sürükleyebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Перетягніть Meowse туди у Finder."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Anda dapat menyeret Meowse ke sana di Finder."
          }
        }
      }
    },
    "%@ is also set to “%@”, so it does both." : {
      "comment" : "A mouse button, then a hold-key setting by name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is also set to “%2$@”, so it does both."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auch für „%@“ festgelegt und macht daher beides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est aussi utilisé pour « %@ » et fait donc les deux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también está asignado a «%@», así que hace ambas cosas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は「%@」にも設定されているため、両方の動作をします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 也设为“%@”，因此会同时执行两者。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is ook ingesteld op ‘%@’ en doet dus beide."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também está definido para “%@”, então faz as duas coisas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também está definido para “%@”, por isso faz as duas coisas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 也設為「%@」，因此會同時執行兩者。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) ‘%@’에도 지정되어 있어 두 동작을 모두 수행합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ также назначена на «%@», поэтому выполняет оба действия."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest też przypisany do „%@”, więc wykonuje obie czynności."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ έχει οριστεί και για «%@», οπότε κάνει και τα δύο."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ayrıca “%@” için de ayarlı, bu yüzden ikisini birden yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ також призначено на «%@», тож виконує обидві дії."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ juga diatur ke “%@”, jadi melakukan keduanya."

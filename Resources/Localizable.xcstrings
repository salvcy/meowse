    "Meowse can’t replace itself at %@. Download the update from the release page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse kann sich in %@ nicht ersetzen. Lade das Update von der Release-Seite."
          }
        },
        "fr" : {
          "stringUnit" : {

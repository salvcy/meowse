    "Everything except Launch at login and Show in menu bar goes back to how Meowse came." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles außer „Bei der Anmeldung öffnen“ und „In der Menüleiste anzeigen“ wird auf den Auslieferungszustand von Meowse zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα εκτός από τα «Άνοιγμα κατά τη σύνδεση» και «Εμφάνιση στη γραμμή μενού» επιστρέφουν στην αρχική κατάσταση του Meowse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo, excepto «Abrir al iniciar sesión» y «Mostrar en la barra de menús», vuelve a como venía Meowse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout, sauf « Ouvrir à la connexion » et « Afficher dans la barre des menus », revient aux réglages d’origine de Meowse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya kecuali “Buka saat masuk” dan “Tampilkan di bar menu” kembali seperti bawaan Meowse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ログイン時に起動」と「メニューバーに表示」以外は、すべてMeowseの初期状態に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘로그인 시 열기’와 ‘메뉴 막대에 표시’를 제외한 모든 항목이 Meowse의 초기 상태로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles behalve ‘Open bij inloggen’ en ‘Toon in menubalk’ wordt teruggezet naar hoe Meowse werd geleverd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko poza „Otwieraj po zalogowaniu” i „Pokazuj na pasku menu” wróci do ustawień początkowych Meowse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo, exceto “Abrir ao iniciar sessão” e “Mostrar na barra de menus”, volta ao padrão do Meowse."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo, exceto “Abrir ao iniciar sessão” e “Mostrar na barra de menus”, volta à configuração original do Meowse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, кроме «Открывать при входе» и «Показывать в строке меню», вернется к исходному состоянию Meowse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Girişte aç” ve “Menü çubuğunda göster” dışındaki her şey Meowse’un ilk hâline döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе, крім «Відкривати під час входу» і «Показувати в рядку меню», повернеться до початкового стану Meowse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除“登录时打开”和“在菜单栏中显示”外，其余设置都将恢复为 Meowse 的初始状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了「登入時開啟」和「在選單列中顯示」外，其他設定都會恢復成 Meowse 的初始狀態。"
          }
        }
      }
    },

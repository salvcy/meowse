    "macOS asks an administrator to allow this once, in Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bittet einmalig einen Administrator, dies in den Anmeldeobjekten zu erlauben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS ζητά μία φορά από έναν διαχειριστή να το επιτρέψει, στα Στοιχεία σύνδεσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pide una vez a un administrador que lo permita, en Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande une seule fois à un administrateur de l’autoriser, dans Ouverture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS meminta administrator mengizinkan ini sekali, di Item Masuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは一度だけ、ログイン項目で管理者に許可を求めます。"
          }

    "Only scroll wheels are affected. Trackpads and the Magic Mouse are left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Mausräder sind betroffen. Trackpads und die Magic Mouse bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les molettes sont concernées. Les trackpads et la Magic Mouse ne sont pas modifiés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo afecta a las ruedas de desplazamiento. Los trackpads y el Magic Mouse no cambian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象はスクロールホイールのみです。トラックパッドとMagic Mouseは変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响滚轮。触控板和妙控鼠标不受影响。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen scrollwielen worden beïnvloed. Trackpads en de Magic Mouse blijven ongemoeid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as rodas de rolagem são afetadas. Trackpads e o Magic Mouse não mudam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as rodas de deslocamento são afetadas. Os trackpads e o Magic Mouse não mudam."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會影響滾輪。觸控式軌跡板和巧控滑鼠不受影響。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤 휠만 영향을 받습니다. 트랙패드와 Magic Mouse는 그대로 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затрагиваются только колеса прокрутки. Трекпады и Magic Mouse не меняются."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany dotyczą tylko kółek przewijania. Gładziki i Magic Mouse pozostają bez zmian."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επηρεάζονται μόνο οι τροχοί κύλισης. Τα trackpad και το Magic Mouse δεν αλλάζουν."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca kaydırma tekerlekleri etkilenir. İzleme dörtgenleri ve Magic Mouse değişmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюються лише коліщатка прокручування. Трекпеди та Magic Mouse не змінюються."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya roda gulir yang terpengaruh. Trackpad dan Magic Mouse tidak diubah."
          }
        }
      }
    },

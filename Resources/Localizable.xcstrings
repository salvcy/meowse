        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het glijden veert terug aan het eind van pagina’s, net als bij een trackpad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rolagem ricocheteia no fim das páginas, como num trackpad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O deslocamento faz ricochete no fim das páginas, como num trackpad."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像觸控式軌跡板一樣，在頁面末端回彈。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랙패드처럼 페이지 끝에서 튕깁니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как на трекпаде, прокрутка пружинит в конце страницы."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak na gładziku, przewijanie odbija się na końcu strony."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όπως σε trackpad, η κύλιση αναπηδά στα άκρα των σελίδων."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme dörtgenindeki gibi, kaydırma sayfa sonlarında esner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як на трекпеді, прокручування пружинить у кінці сторінки."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guliran memantul di ujung halaman, seperti trackpad."
          }
        }
      }
    },
    "Hold these while scrolling. Click one, then press a modifier key or an extra mouse button. Right-click a modifier to use only its left or right key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese beim Scrollen gedrückt. Klicke auf eines und drücke dann eine Sondertaste oder eine zusätzliche Maustaste. Klicke mit der rechten Maustaste auf eine Sondertaste, um nur die linke oder rechte zu verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez-les pendant le défilement. Cliquez sur l’un, puis appuyez sur une touche de modification ou un bouton de souris supplémentaire. Cliquez avec le bouton droit sur une touche de modification pour n’utiliser que celle de gauche ou de droite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenlas pulsadas al desplazarte. Haz clic en una y pulsa una tecla modificadora o un botón extra del ratón. Haz clic derecho en una tecla modificadora para usar solo la izquierda o la derecha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロール中に押し続けます。項目をクリックし、修飾キーまたは追加のマウスボタンを押してください。修飾キーを右クリックすると、左右どちらか一方だけを使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动时按住这些键。点按其中一项，然后按下修饰键或额外的鼠标按钮。右键点按修饰键可仅使用其左侧或右侧的键。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd deze ingedrukt tijdens het scrollen. Klik op een ervan en druk dan op een speciale toets of een extra muisknop. Klik met de rechtermuisknop op een speciale toets om alleen de linker- of rechtertoets te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionadas enquanto rola. Clique em uma e pressione uma tecla modificadora ou um botão extra do mouse. Clique com o botão direito em uma tecla modificadora para usar só a da esquerda ou da direita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premidas enquanto percorre. Clique numa e prima uma tecla modificadora ou um botão extra do rato. Clique com o botão direito numa tecla modificadora para usar só a da esquerda ou da direita."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捲動時按住這些按鍵。按一下其中一項，然後按下變更鍵或額外的滑鼠按鈕。以右鍵按一下變更鍵即可只使用其左側或右側的按鍵。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤하는 동안 누르고 있으십시오. 하나를 클릭한 다음 보조 키나 추가 마우스 버튼을 누르십시오. 보조 키를 오른쪽 클릭하면 왼쪽 또는 오른쪽 키만 사용할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте их при прокрутке. Нажмите на поле, затем нажмите клавишу-модификатор или дополнительную кнопку мыши. Нажмите на модификатор правой кнопкой, чтобы использовать только левую или правую клавишу."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymuj je podczas przewijania. Kliknij jedno, a następnie naciśnij klawisz modyfikujący lub dodatkowy przycisk myszy. Kliknij modyfikator prawym przyciskiem, aby używać tylko lewego lub prawego klawisza."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε τα πατημένα κατά την κύλιση. Κάντε κλικ σε ένα και πατήστε ένα πλήκτρο τροποποίησης ή ένα επιπλέον κουμπί ποντικιού. Κάντε δεξί κλικ σε ένα πλήκτρο τροποποίησης για να χρησιμοποιείτε μόνο το αριστερό ή το δεξί."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırırken bunları basılı tutun. Birini tıklayın, sonra bir değiştirici tuşa veya ek bir fare düğmesine basın. Yalnızca sol ya da sağ tuşu kullanmak için değiştiriciyi sağ tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте їх під час прокручування. Натисніть на поле, потім натисніть клавішу-модифікатор або додаткову кнопку миші. Натисніть на модифікатор правою кнопкою, щоб використовувати лише ліву або праву клавішу."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol ini saat menggulir. Klik salah satu, lalu tekan tombol pengubah atau tombol mouse tambahan. Klik kanan tombol pengubah untuk hanya memakai tombol kiri atau kanannya."
          }
        }
      }
    },

    "Without acceleration the pointer goes the same distance for every bit the mouse moves. Drag the dot to set how far." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Beschleunigung bewegt sich der Zeiger bei jeder Mausbewegung gleich weit. Ziehe den Punkt, um die Distanz festzulegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans accélération, le pointeur parcourt la même distance pour chaque mouvement de la souris. Faites glisser le point pour la régler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin aceleración, el puntero recorre la misma distancia por cada movimiento del ratón. Arrastra el punto para ajustarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加速なしでは、マウスの移動量に対してポインタは常に同じ距離だけ動きます。点をドラッグして距離を設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有加速时，鼠标每移动一点，指针都移动相同的距离。拖移圆点以设定距离。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder versnelling gaat de aanwijzer voor elke muisbeweging even ver. Sleep de stip om in te stellen hoe ver."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem aceleração, o cursor percorre a mesma distância a cada movimento do mouse. Arraste o ponto para definir a distância."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem aceleração, o cursor percorre a mesma distância a cada movimento do rato. Arraste o ponto para definir a distância."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有加速度時，滑鼠每移動一點，指標都會移動相同的距離。拖移圓點以設定距離。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가속이 없으면 마우스가 움직일 때마다 포인터가 같은 거리만큼 이동합니다. 점을 드래그하여 거리를 설정하십시오."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без ускорения указатель смещается на одно и то же расстояние при каждом движении мыши. Перетащите точку, чтобы задать его."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez przyspieszenia wskaźnik przesuwa się o tę samą odległość przy każdym ruchu myszy. Przeciągnij punkt, aby ją ustawić."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς επιτάχυνση ο δείκτης διανύει την ίδια απόσταση για κάθε κίνηση του ποντικιού. Σύρετε την κουκκίδα για να την ορίσετε."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlanma olmadan imleç, farenin her hareketinde aynı mesafeyi gider. Mesafeyi ayarlamak için noktayı sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без прискорення вказівник зсувається на ту саму відстань за кожного руху миші. Перетягніть точку, щоб задати її."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akselerasi, penunjuk bergerak sejauh yang sama untuk setiap gerakan mouse. Seret titik untuk mengatur jaraknya."
          }
        }
      }
    },

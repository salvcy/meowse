    "A button or side wheel with an action does it instead of what it normally does. The side buttons go back and forward." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Taste oder ein Seitenrad mit einer Aktion führt diese statt ihrer normalen Funktion aus. Die Seitentasten gehen zurück und vorwärts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κουμπί ή πλαϊνός τροχός με ενέργεια την εκτελεί αντί για τη συνηθισμένη του λειτουργία. Τα πλαϊνά κουμπιά πηγαίνουν πίσω και εμπρός."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón o rueda lateral con una acción la realiza en lugar de su función habitual. Los botones laterales retroceden y avanzan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton ou une molette latérale associé à une action l’effectue à la place de sa fonction habituelle. Les boutons latéraux reculent et avancent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol atau roda samping dengan tindakan akan melakukannya sebagai ganti fungsi normalnya. Tombol samping untuk kembali dan maju."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションを設定したボタンやサイドホイールは、本来の動作の代わりにそのアクションを実行します。サイドボタンは「戻る」と「進む」になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작이 지정된 버튼이나 측면 휠은 원래 기능 대신 그 동작을 수행합니다. 측면 버튼은 뒤로 및 앞으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een knop of zijwiel met een actie voert die uit in plaats van wat het normaal doet. De zijknoppen gaan terug en vooruit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk lub boczne kółko z przypisaną czynnością wykonuje ją zamiast swojej zwykłej funkcji. Przyciski boczne przechodzą wstecz i dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão ou roda lateral com uma ação a executa no lugar da sua função normal. Os botões laterais voltam e avançam."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão ou roda lateral com uma ação executa-a em vez da sua função normal. Os botões laterais retrocedem e avançam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка или боковое колесо с назначенным действием выполняет его вместо обычной функции. Боковые кнопки переходят назад и вперед."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylem atanmış bir düğme ya da yan tekerlek, normal işlevi yerine o eylemi yapar. Yan düğmeler geri ve ileri gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка або бічне коліщатко з призначеною дією виконує її замість звичайної функції. Бічні кнопки переходять назад і вперед."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设定了操作的按钮或侧滚轮会执行该操作，而非其原本的功能。侧键用于后退和前进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定了動作的按鈕或側滾輪會執行該動作，取代原本的功能。側邊按鈕用於上一頁和下一頁。"
          }
        }
      }
    },

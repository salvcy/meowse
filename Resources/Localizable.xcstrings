            "value" : "O Meowse não consegue se substituir em %@. Baixe a atualização na página da versão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Meowse não consegue substituir-se em %@. Descarregue a atualização na página da versão."

    "Meowse can’t replace itself at %@. Download the update from the release page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse kann sich in %@ nicht ersetzen. Lade das Update von der Release-Seite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Meowse δεν μπορεί να αντικαταστήσει τον εαυτό του στο %@. Κατεβάστε την ενημέρωση από τη σελίδα έκδοσης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse no puede reemplazarse en %@. Descarga la actualización desde la página de la versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse ne peut pas se remplacer dans %@. Téléchargez la mise à jour depuis la page de publication."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse tidak dapat mengganti dirinya di %@. Unduh pembaruan dari halaman rilis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowseは%@で自身を置き換えられません。リリースページからアップデートをダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meowse가 %@에서 자신을 대체할 수 없습니다. 릴리스 페이지에서 업데이트를 다운로드하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {

    "This build isn’t signed, so it can’t verify updates. Install the new version manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build ist nicht signiert und kann Updates daher nicht prüfen. Installiere die neue Version manuell."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η έκδοση δεν είναι υπογεγραμμένη, οπότε δεν μπορεί να επαληθεύσει ενημερώσεις. Εγκαταστήστε τη νέα έκδοση χειροκίνητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión no está firmada, así que no puede verificar actualizaciones. Instala la nueva versión manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
